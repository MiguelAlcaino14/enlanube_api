generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}

model Lead {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String
  telefono  String?
  empresa   String?
  mensaje   String?
  servicio  String?
  createdAt DateTime @default(now())
}

model Cotizacion {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String
  telefono  String?
  empresa   String?
  servicio  String
  detalle   String?
  estado    String   @default("pendiente")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
